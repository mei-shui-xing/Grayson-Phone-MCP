+func lookupWithDOH(name string, recordType string) ([]dohAnswer, error) {
+	var lastErr error
+	for _, endpoint := range dohEndpoints {
+		answers, err := queryDOHEndpoint(endpoint, name, recordType)
+		if err == nil && len(answers) > 0 {
+			return answers, nil
+		}
+		if err != nil {
+			lastErr = err
+		}
+	}
+	if lastErr == nil {
+		lastErr = fmt.Errorf("empty DoH response for %s %s", name, recordType)
+	}
+	return nil, lastErr
+}
+
+func queryDOHEndpoint(endpoint dohEndpoint, name string, recordType string) ([]dohAnswer, error) {
+	transport := &http.Transport{
+		DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+			ips, err := platformLookupIPs(endpoint.serverName)
+			if err != nil {
+				return nil, err
+			}
+			var lastErr error
+			var dialer net.Dialer
+			for _, ip := range ips {
+				conn, err := dialer.DialContext(ctx, "tcp", net.JoinHostPort(ip.String(), "443"))
+				if err == nil {
+					return conn, nil
+				}
+				lastErr = err
+			}
+			return nil, lastErr
+		},
+		TLSClientConfig: &tls.Config{ServerName: endpoint.serverName, MinVersion: tls.VersionTLS12},
+	}
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, Timeout: dotTimeout}
+	requestURL := endpoint.url + "?name=" + url.QueryEscape(name) + "&type=" + url.QueryEscape(recordType)
+	req, err := http.NewRequestWithContext(context.Background(), http.MethodGet, requestURL, nil)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Accept", "application/dns-json")
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("DoH endpoint returned HTTP %d", resp.StatusCode)
+	}
+	var payload dohResponse
+	if err := json.NewDecoder(resp.Body).Decode(&payload); err != nil {
+		return nil, err
+	}
+	if payload.Status != 0 {
+		return nil, fmt.Errorf("DoH endpoint returned DNS status %d", payload.Status)
+	}
+	return payload.Answer, nil
+}
+
+func parseDOHSRVAnswers(answers []dohAnswer) ([]*net.SRV, error) {
+	var records []*net.SRV
+	for _, answer := range answers {
+		if answer.Type != 33 {
+			continue
+		}
+		fields := strings.Fields(answer.Data)
+		if len(fields) != 4 {
+			continue
+		}
+		priority, errPriority := strconv.ParseUint(fields[0], 10, 16)
+		weight, errWeight := strconv.ParseUint(fields[1], 10, 16)
+		port, errPort := strconv.ParseUint(fields[2], 10, 16)
+		if errPriority != nil || errWeight != nil || errPort != nil {
+			continue
+		}
+		records = append(records, &net.SRV{
+			Target:   strings.TrimSuffix(fields[3], "."),
+			Port:     uint16(port),
+			Priority: uint16(priority),
+			Weight:   uint16(weight),
+		})
+	}
+	if len(records) == 0 {
+		return nil, fmt.Errorf("DoH returned no usable SRV records")
+	}
+	return records, nil
+}
+
+func parseDOHIPAnswers(answers []dohAnswer) []net.IP {
+	var ips []net.IP
+	for _, answer := range answers {
+		if answer.Type != 1 && answer.Type != 28 {
+			continue
+		}
+		if ip := net.ParseIP(strings.TrimSpace(answer.Data)); ip != nil {
+			ips = append(ips, ip)
+		}
+	}
+	return ips
+}
