@@ -0,0 +1,62 @@
+//go:build android && cgo
+
+package allregions
+
+/*
+#include <arpa/inet.h>
+#include <netdb.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int android_lookup_host(const char *host, char *output, size_t output_len) {
+    struct addrinfo hints;
+    struct addrinfo *result = NULL;
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+
+    int status = getaddrinfo(host, NULL, &hints, &result);
+    if (status != 0 || result == NULL) {
+        return status == 0 ? EAI_NONAME : status;
+    }
+
+    int found = EAI_NONAME;
+    for (struct addrinfo *entry = result; entry != NULL; entry = entry->ai_next) {
+        void *address = NULL;
+        if (entry->ai_family == AF_INET) {
+            address = &((struct sockaddr_in *)entry->ai_addr)->sin_addr;
+        } else if (entry->ai_family == AF_INET6) {
+            address = &((struct sockaddr_in6 *)entry->ai_addr)->sin6_addr;
+        }
+        if (address != NULL && inet_ntop(entry->ai_family, address, output, output_len) != NULL) {
+            found = 0;
+            break;
+        }
+    }
+    freeaddrinfo(result);
+    return found;
+}
+*/
+import "C"
+
+import (
+	"fmt"
+	"net"
+	"unsafe"
+)
+
+func platformLookupIPs(host string) ([]net.IP, error) {
+	cHost := C.CString(host)
+	defer C.free(unsafe.Pointer(cHost))
+
+	buffer := make([]byte, 64)
+	status := C.android_lookup_host(cHost, (*C.char)(unsafe.Pointer(&buffer[0])), C.size_t(len(buffer)))
+	if status != 0 {
+		return nil, fmt.Errorf("Android libc resolver failed with status %d", int(status))
+	}
+	ip := net.ParseIP(C.GoString((*C.char)(unsafe.Pointer(&buffer[0]))))
+	if ip == nil {
+		return nil, fmt.Errorf("Android libc resolver returned an invalid address")
+	}
+	return []net.IP{ip}, nil
+}
