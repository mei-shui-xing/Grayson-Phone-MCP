+func dialEdgeTCP(ctx context.Context, dialer *net.Dialer, target string) (net.Conn, error) {
+	proxyAddress := os.Getenv("CLOUDFLARED_EDGE_PROXY")
+	if proxyAddress == "" {
+		return dialer.DialContext(ctx, "tcp", target)
+	}
+
+	conn, err := dialer.DialContext(ctx, "tcp", proxyAddress)
+	if err != nil {
+		return nil, errors.Wrap(err, "dial Android VPN proxy")
+	}
+	if _, err := fmt.Fprintf(conn, "CONNECT %s HTTP/1.1\r\nHost: %s\r\nProxy-Connection: Keep-Alive\r\n\r\n", target, target); err != nil {
+		conn.Close()
+		return nil, errors.Wrap(err, "write HTTP CONNECT request")
+	}
+	response, err := http.ReadResponse(bufio.NewReader(conn), &http.Request{Method: http.MethodConnect})
+	if err != nil {
+		conn.Close()
+		return nil, errors.Wrap(err, "read HTTP CONNECT response")
+	}
+	if response.StatusCode != http.StatusOK {
+		response.Body.Close()
+		conn.Close()
+		return nil, fmt.Errorf("Android VPN proxy CONNECT returned %s", response.Status)
+	}
+	return conn, nil
+}
