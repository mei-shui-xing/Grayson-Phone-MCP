+func lookupSRVWithFallback(srvService string, srvProto string, srvName string) (string, []*net.SRV, error) {
+	queryName := "_" + srvService + "._" + srvProto + "." + srvName
+	answers, dohErr := lookupWithDOH(queryName, "SRV")
+	if dohErr == nil {
+		if addrs, err := parseDOHSRVAnswers(answers); err == nil && len(addrs) > 0 {
+			return "", addrs, nil
+		}
+	}
+
+	// Android VPN clients commonly hijack ordinary UDP/53 and answer it from
+	// their TUN DNS gateway. Try that path first: unlike direct DoT/DoH
+	// bootstrap IPs, it continues to work when the VPN rejects direct TCP
+	// connections while operating in global mode.
+	cname, addrs, udpErr := lookupSRVWithUDPDNS(srvService, srvProto, srvName)
+	if udpErr == nil && len(addrs) > 0 {
+		return cname, addrs, nil
+	}
+
+	cname, addrs, dotErr := lookupSRVWithDOT(srvService, srvProto, srvName)
+	if dotErr == nil && len(addrs) > 0 {
+		return cname, addrs, nil
+	}
+	return "", nil, errors.Wrapf(dotErr, "DoH failed (%v), UDP DNS failed (%v), and DoT failed", dohErr, udpErr)
+}
