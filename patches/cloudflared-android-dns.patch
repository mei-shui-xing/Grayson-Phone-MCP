+func lookupIPWithFallback(host string) ([]net.IP, error) {
+	var answers []dohAnswer
+	var dohErr error
+	for _, recordType := range []string{"A", "AAAA"} {
+		resolved, err := lookupWithDOH(host, recordType)
+		if err != nil {
+			dohErr = err
+			continue
+		}
+		answers = append(answers, resolved...)
+	}
+	if ips := parseDOHIPAnswers(answers); len(ips) > 0 {
+		return ips, nil
+	}
+
+	ips, udpErr := lookupIPWithUDPDNS(host)
+	if udpErr == nil && len(ips) > 0 {
+		return ips, nil
+	}
+
+	ips, dotErr := lookupIPWithDOT(host)
+	if dotErr == nil && len(ips) > 0 {
+		return ips, nil
+	}
+	var lastErr error
+	ips = parseDOHIPAnswers(answers)
+	if len(ips) == 0 {
+		if lastErr == nil {
+			lastErr = fmt.Errorf("DoH returned no IP addresses")
+		}
+		return nil, errors.Wrapf(lastErr, "DoH failed (%v), UDP DNS failed (%v), and DoT failed (%v)", dohErr, udpErr, dotErr)
+	}
+	return ips, nil
